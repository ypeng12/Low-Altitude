{
  "random_seed": 42,
  "repository_root": "../../..",
  "inputs": {
    "master_reviews": "data/cleaned_datasets/tripadvisor_processed_master.csv",
    "nrc_reviews": "data/cleaned_datasets/tripadvisor_level3_econometrics.csv",
    "fasttext_language_model": "lid.176.bin"
  },
  "output_dir": "research_modules/module1_emotion_discovery/outputs",
  "language": {
    "english_label": "en",
    "include_probability": 0.7,
    "uncertain_probability": 0.7,
    "top_k": 3,
    "text_fields": [
      "review_title",
      "review_text"
    ]
  },
  "segmentation": {
    "min_sentence_tokens": 1,
    "min_clause_tokens": 3,
    "max_span_words": 120,
    "split_long_sentences": true,
    "use_clauses_for_analysis": true
  },
  "embedding": {
    "model_name": "BAAI/bge-small-en-v1.5",
    "model_revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a",
    "backend": "onnx",
    "onnx_provider": "CPUExecutionProvider",
    "batch_size": 128,
    "device": "cpu",
    "normalize_embeddings": true,
    "show_progress_bar": true
  },
  "clustering": {
    "pca_components": 50,
    "umap_components": 10,
    "umap_metric": "cosine",
    "umap_min_dist": 0.0,
    "umap_n_neighbors": [
      30
    ],
    "experiment_seeds": [
      42,
      73,
      101
    ],
    "min_cluster_size": [
      100,
      250
    ],
    "min_samples": [
      10,
      25
    ],
    "cluster_selection_method": "eom",
    "silhouette_sample_size": 5000,
    "max_analysis_spans": null
  },
  "reporting": {
    "top_phrases": 15,
    "representative_examples": 10,
    "max_tfidf_features": 50000,
    "ngram_range": [
      1,
      3
    ],
    "minimum_nrc_parent_enrichment": 1.1,
    "uncertain_confidence_threshold": 0.55
  }
}
