    "umap_min_dist": 0.0,
    "umap_n_neighbors": 30,
    "experiment_seeds": [42, 73, 101],
    "min_cluster_size": [40, 100],
    "min_samples": [5, 15],
    "cluster_selection_method": "eom",
    "silhouette_sample_size": 5000,
    "representative_examples": 10,
    "top_phrases": 15,
    "max_tfidf_features": 30000,
    "ngram_range": [1, 3]
  },
  "goemotions_reference": {
    "role": "post_cluster_continuous_reference_only",
