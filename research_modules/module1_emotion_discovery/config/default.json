    "backend": "onnx",
    "onnx_provider": "CPUExecutionProvider",
    "batch_size": 128,
    "device": "cpu",
    "normalize_embeddings": true,
    "show_progress_bar": true
  },
  "clustering": {
    "pca_components": 50,
    "umap_components": 10,
    "umap_metric": "cosine",
    "umap_min_dist": 0.0,
    "umap_n_neighbors": [
      30
    ],
    "experiment_seeds": [
      42,
      73,
      101
    ],
    "min_cluster_size": [
      100,
      250
    ],
    "min_samples": [
      10,
      25
    ],
    "cluster_selection_method": "eom",
    "silhouette_sample_size": 5000,
    "max_analysis_spans": null
  },
  "reporting": {
    "top_phrases": 15,
    "representative_examples": 10,
    "max_tfidf_features": 50000,
    "ngram_range": [
      1,
      3
    ],
    "minimum_nrc_parent_enrichment": 1.1,
    "uncertain_confidence_threshold": 0.55
  },
  "focused_discovery": {
    "selector": "approved_cate_107_exact_word_match",
    "pca_components": 50,
    "umap_components": 10,
    "umap_metric": "cosine",
    "umap_min_dist": 0.0,
    "umap_n_neighbors": 30,
    "experiment_seeds": [42, 73, 101],
    "min_cluster_size": [40, 100],
    "min_samples": [5, 15],
    "cluster_selection_method": "eom",
    "silhouette_sample_size": 5000,
    "representative_examples": 10,
    "top_phrases": 15,
    "max_tfidf_features": 30000,
    "ngram_range": [1, 3]
  },
  "goemotions_reference": {
    "role": "post_cluster_continuous_reference_only",
