    "show_progress_bar": true
  },
  "clustering": {
    "pca_components": 50,
    "umap_components": 10,
    "umap_metric": "cosine",
    "umap_min_dist": 0.0,
    "umap_n_neighbors": [
      30
    ],
    "experiment_seeds": [
      42,
      73,
      101
    ],
    "min_cluster_size": [
      100,
      250
    ],
    "min_samples": [
      10,
      25
    ],
    "cluster_selection_method": "eom",
    "silhouette_sample_size": 5000,
    "max_analysis_spans": null
  },
  "reporting": {
    "top_phrases": 15,
    "representative_examples": 10,
    "max_tfidf_features": 50000,
    "ngram_range": [
      1,
      3
    ],
