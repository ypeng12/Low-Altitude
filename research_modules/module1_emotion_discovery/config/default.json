    "model_revision": "90ee0c1c4796d370e68968687b8ba51fc11224f4",
    "onnx_filename": "onnx/model_quantized.onnx",
    "provider": "CPUExecutionProvider",
    "intra_op_num_threads": 4,
    "batch_size": 64,
    "max_length": 256,
    "profile_display_labels": 5
  },
  "post_cluster_candidate_synthesis": {
